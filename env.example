# Contentstack Configuration
# Copy this file to .env.local and fill in your values

CONTENTSTACK_API_KEY=your_api_key_here
CONTENTSTACK_DELIVERY_TOKEN=your_delivery_token_here
CONTENTSTACK_ENVIRONMENT=development
CONTENTSTACK_BRANCH=main

# Optional: For Live Preview
# IMPORTANT: You must also configure Base URL in Contentstack Dashboard:
# 1. Go to Settings > Environments
# 2. Set Base URL for your environment (e.g., http://localhost:3000 for local dev)
# 3. Go to Settings > Live Preview
# 4. Enable Live Preview and select your environment as Default Preview Environment
# Without Base URL configured, you'll get CORS and 401 errors!
CONTENTSTACK_PREVIEW_TOKEN=your_preview_token_here
CONTENTSTACK_PREVIEW_HOST=rest-preview.contentstack.com
NEXT_PUBLIC_ENABLE_LIVE_PREVIEW=false
# Enable Live Edit Tags - Set to 'true' to show edit buttons in development
# Edit buttons allow editors to jump directly to content fields in Contentstack
CONTENTSTACK_LIVE_EDIT_TAGS=true

# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Contentstack Automate Webhook URLs
# Get these from your Contentstack Automate workflow webhook actions
NEXT_PUBLIC_CONTENTSTACK_WEBHOOK_URL=your_completion_webhook_url_here
NEXT_PUBLIC_CONTENTSTACK_ENROLLMENT_WEBHOOK_URL=your_enrollment_webhook_url_here

# Lytics Personalization Configuration
# Get your Account ID from Lytics Dashboard > Account Settings
# This enables user tracking and audience-based personalization
NEXT_PUBLIC_LYTICS_ACCOUNT_ID=7214001a5c1b87450b62ba838282e067

# Contentstack Personalize Configuration
# Get your Project UID from Contentstack Personalize Dashboard
# This enables variant delivery based on user audience
NEXT_PUBLIC_CONTENTSTACK_PERSONALIZE_PROJECT_UID=693f09b27ed0bb7cec4ff8db

# Optional: Custom Edge API URL for Contentstack Personalize
# Only set this if you're using a custom edge API endpoint
NEXT_PUBLIC_CONTENTSTACK_PERSONALIZE_EDGE_API_URL=

# Algolia Search Configuration
# Get these from your Algolia Dashboard > Settings > API Keys
# Application ID and Search-Only API Key are safe for client-side use
NEXT_PUBLIC_ALGOLIA_APP_ID=your_algolia_app_id_here
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=your_algolia_search_only_key_here
# Admin API Key is for server-side only (sync scripts) - NEVER expose to client!
ALGOLIA_ADMIN_API_KEY=your_algolia_admin_key_here
